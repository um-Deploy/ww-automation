# ── Your Business Info ────────────────────────────────────────────────────────
GIFTING_BUSINESS_NAME=WW Gifts
GIFTING_OUTREACH_PHONE=91XXXXXXXXXX        # Your WhatsApp number (with country code)
GIFTING_CATALOG_URL=                        # Optional: link to your product catalog/website

# ── Scraping Config ───────────────────────────────────────────────────────────
# Comma-separated cities to target. Default is major Indian metros.
GIFTING_CITIES=Delhi,Noida,Gurgaon,Mumbai,Pune,Bangalore,Hyderabad,Chennai,Ahmedabad,Kolkata

MAX_OUTREACH_PER_RUN=15                    # Max WhatsApp messages to send per run
MAX_ENRICH_PER_RUN=30                      # Max leads to enrich (website parsing) per run
SKIP_ENRICH=false                          # Set true to skip website contact enrichment (faster)

DRY_RUN=false                              # Set true to test without sending messages

# ── Google Sheets (optional — CSV fallback used if not configured) ─────────────
GOOGLE_SHEET_ID=                           # Your Google Sheet ID (from URL)
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./credentials/google-service-account.json
