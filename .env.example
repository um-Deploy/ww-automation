# ─── Groq (FREE AI) ─────────────────────────────────────────────────────────
# Sign up free at https://console.groq.com → API Keys → Create
# Free tier: ~14,400 requests/day — more than enough for a WhatsApp bot
GROQ_API_KEY=your_groq_api_key_here

# ─── Google Sheets ──────────────────────────────────────────────────────────
# ID from the Google Sheets URL:  /spreadsheets/d/<SHEET_ID>/edit
GOOGLE_SHEET_ID=your_google_sheet_id_here
# Path to service account JSON key file (see SETUP.md)
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./credentials/google-service-account.json

# ─── Optional ───────────────────────────────────────────────────────────────
PORT=3000
# Comma-separated WhatsApp numbers (with country code, no +) that bypass bot → human only
HUMAN_HANDOFF_NUMBERS=

# ─── Lead Scraper Agent (lead-scraper/) ─────────────────────────────────────
# Google Places API key — enable "Places API" in Google Cloud Console
# $200/month free credit covers ~6,000 lead lookups/month
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# Your business name shown in outreach messages
OUTREACH_BUSINESS_NAME=WoodWaley

# Your WhatsApp number shown in outreach messages (with country code, no +)
OUTREACH_PHONE=91XXXXXXXXXX

# Max messages to send per daily run (default: 20 — avoid spam flags)
MAX_OUTREACH_PER_RUN=20

# Seconds to wait between messages (default: 45 — humanlike pacing)
MSG_DELAY_SECONDS=45

# Set to "true" to test scraping without sending any WhatsApp messages
DRY_RUN=false

# ─── Meta Ads Agent ──────────────────────────────────────────────────────────
# See Meta Ads Agent/.env.example for full setup instructions
META_APP_ID=your_app_id_here
META_APP_SECRET=your_app_secret_here
META_ACCESS_TOKEN=your_access_token_here
META_AD_ACCOUNT_ID=act_XXXXXXXXXXXXXXXXX
ANTHROPIC_API_KEY=sk-ant-your_key_here
SPEND_ALERT_THRESHOLD_USD=50.0
