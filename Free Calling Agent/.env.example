# ─── Twilio (phone calls) ────────────────────────────────────────────────────
# Sign up free at https://twilio.com → you get $15 trial credit (~1700 min to India)
# Console → Account Info → Account SID + Auth Token
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
# Your Twilio phone number (with + and country code)
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# ─── Groq (FREE AI — no credit card needed) ──────────────────────────────────
# Sign up free at https://console.groq.com → API Keys → Create
# Free tier: 14,400 requests/day — more than enough
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Google Sheets ────────────────────────────────────────────────────────────
GOOGLE_SHEET_ID=your_google_sheet_id_here
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=../credentials/google-service-account.json

# ─── Server ───────────────────────────────────────────────────────────────────
# Public URL — use ngrok for local dev: ngrok http 8000
# Get ngrok free at https://ngrok.com
BASE_URL=https://your-ngrok-url.ngrok.io
PORT=8000

# ─── Business Config ──────────────────────────────────────────────────────────
BUSINESS_NAME=WoodWaley
AGENT_NAME=Priya
