# ─── Meta Ads (Facebook / Instagram) ────────────────────────────────────────
# 1. Go to https://developers.facebook.com → My Apps → Create App
# 2. Add "Marketing API" product to your app
# 3. Generate a User Access Token with ads_read + ads_management permissions
#    (use https://developers.facebook.com/tools/explorer/ to generate)
# 4. For production use a System User token (never expires):
#    Business Manager → Settings → System Users → Generate Token

META_APP_ID=your_app_id_here
META_APP_SECRET=your_app_secret_here
META_ACCESS_TOKEN=your_access_token_here

# Ad Account ID — find in Meta Business Manager or Ads Manager URL
# Format is always: act_XXXXXXXXXXXXXXXXX
META_AD_ACCOUNT_ID=act_XXXXXXXXXXXXXXXXX

# ─── Claude (Anthropic) ──────────────────────────────────────────────────────
# Get your key at https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-your_key_here

# ─── Google Sheets (shared with other agents) ────────────────────────────────
GOOGLE_SHEET_ID=your_google_sheet_id_here
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=../credentials/ww-ai-automation-6e7f331fdd57.json

# ─── Spend Monitoring ────────────────────────────────────────────────────────
# Alert threshold in USD — agent will warn when today's spend exceeds this
SPEND_ALERT_THRESHOLD_USD=50.0

# ─── Business ────────────────────────────────────────────────────────────────
BUSINESS_NAME=WoodWaley
